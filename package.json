{
  "name": "muvekkil-kasa-defteri",
  "version": "0.1.0",
  "description": "Woontegra Müvekkil Kasa Defteri — geliştirilebilir kaynak",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "author": "Woontegra",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/fix-electron-shadow.cjs",
    "dev": "node scripts/run-dev.cjs",
    "build": "electron-vite build && electron-vite build --config electron.vite.premium.config.ts",
    "dist:win": "npm run build && electron-builder --win nsis",
    "split-css": "node scripts/split-css.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.woontegra.muvekkilkasadefteri",
    "productName": "Woontegra Müvekkil Kasa Defteri",
    "artifactName": "Woontegra-Muvekkil-Kasa-Defteri-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
