{
  "name": "muvekkil-kasa-defteri",
  "version": "0.1.11",
  "description": "Woontegra Müvekkil Kasa Defteri — geliştirilebilir kaynak",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "author": "Woontegra",
  "config": {
    "updateBaseUrl": "https://updates.woontegra.com/updates/muvekkil-kasa-defteri/windows"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/fix-electron-shadow.cjs",
    "dev": "node scripts/run-dev.cjs",
    "dev:premium": "node scripts/run-dev.cjs --renderer=premium",
    "dev:legacy": "node scripts/run-dev.cjs --renderer=legacy",
    "test:gui": "node scripts/run-gui-live-test.cjs",
    "test:vekalet-sil-input": "node scripts/run-vekalet-sil-input-test.cjs",
    "test:pending-approval": "node scripts/run-pending-approval-test.cjs",
    "test:accounting-period": "node scripts/run-accounting-period-test.cjs",
    "test:multi-currency": "node scripts/run-multi-currency-test.cjs",
    "test:finans-kalem": "node scripts/run-finans-kalem-test.cjs",
    "test:guvenli-sil": "node scripts/run-guvenli-sil-test.cjs",
    "test:vekalet-guvenli-sil": "node scripts/run-vekalet-guvenli-sil-test.cjs",
    "test:randevu": "node scripts/run-randevu-smoke-test.cjs",
    "test:tahsilat-merkezi": "node scripts/run-tahsilat-merkezi-test.cjs",
    "test:mali-ekstre": "node scripts/run-mali-ekstre-test.cjs",
    "test:final-parity": "node scripts/run-final-parity-test.cjs",
    "test:ui-parity": "node scripts/run-ui-parity-source-test.cjs",
    "test:masraf-input": "node scripts/run-masraf-input-test.cjs",
    "test:input-modal": "node scripts/test-input-modal-regression.cjs",
    "test:premium-gui": "node scripts/run-premium-gui-test.cjs",
    "test:premium-responsive": "node scripts/run-premium-responsive-test.cjs",
    "test:premium-print": "node scripts/run-premium-print-test.cjs",
    "test:premium-crud-gui": "node scripts/run-premium-crud-gui-test.cjs",
    "test:premium-input": "node scripts/run-premium-input-regression-test.cjs",
    "test:premium-all": "node scripts/run-premium-all-tests.cjs",
    "build": "electron-vite build && electron-vite build --config electron.vite.premium.config.ts",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:update": "node scripts/run-dist-win-update.cjs",
    "release:update": "node scripts/run-release-update.cjs",
    "release:update:metadata": "node scripts/run-release-update-metadata.cjs",
    "split-css": "node scripts/split-css.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.woontegra.muvekkilkasadefteri",
    "productName": "Woontegra Müvekkil Kasa Defteri",
    "artifactName": "Woontegra-Muvekkil-Kasa-Defteri-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
